HOST=0.0.0.0
PORT=4000
NODE_ENV=production

# Keep app data on the Windows desktop disk.
DATA_ROOT=G:\\it-control-center\\server
DB_PATH=db.json
SQLITE_PATH=data.sqlite
UPLOADS_DIR=uploads
BACKUPS_DIR=backups

# Optional backup behavior.
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_RUN_ON_STARTUP=true
AUTO_BACKUP_INTERVAL_HOURS=24
AUTO_BACKUP_RETENTION_DAYS=30
STARTUP_BACKUP_RECOVERY_ENABLED=true
BACKUP_COMPRESS=true

# Use your desktop LAN URL here so users on your network open the same server.
# Example: http://192.168.1.84:4000
PUBLIC_APP_URL=http://192.168.1.84:4000

# Telegram alerts.
TELEGRAM_ALERT_ENABLED=true
TELEGRAM_BOT_TOKEN=123456789:your_main_bot_token_here
TELEGRAM_CHAT_ID=-1001111111111
TELEGRAM_CHAT_IDS=-1001111111111,-1002222222222

TELEGRAM_MAINTENANCE_BOT_TOKEN=123456789:your_maintenance_bot_token_here
TELEGRAM_MAINTENANCE_CHAT_ID=-1001111111111
TELEGRAM_MAINTENANCE_CHAT_IDS=-1001111111111,-1002222222222

TELEGRAM_TOOL_BOT_TOKEN=123456789:your_tools_bot_token_here
TELEGRAM_TOOL_CHAT_ID=-1003333333333
TELEGRAM_TOOL_CHAT_IDS=-1003333333333

# Optional: automatically discover chats that have messaged the bot.
TELEGRAM_DISCOVER_CHAT_IDS=true

# Optional printer credentials.
PRINTER_LOGIN_CAMPUS1_USERNAME=Administrator
PRINTER_LOGIN_CAMPUS1_PASSWORD=your_printer_password
PRINTER_LOGIN_CAMPUS21_USERNAME=Administrator
PRINTER_LOGIN_CAMPUS21_PASSWORD=your_printer_password
PRINTER_LOGIN_CAMPUS22_USERNAME=Administrator
PRINTER_LOGIN_CAMPUS22_PASSWORD=your_printer_password
PRINTER_LOGIN_CAMPUS3_USERNAME=your_printer_username
PRINTER_LOGIN_CAMPUS3_PASSWORD=your_printer_password

# Optional bootstrap passwords for a brand-new local server only.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_VIEWER_PASSWORD=
